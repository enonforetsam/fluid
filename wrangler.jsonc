{
  "name": "fluid",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": ".public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "drop-trailing-slash" },
  "vars": { "STAGE": "production" },
  "routes": [
    { "pattern": "fluid.krackeddevs.com", "custom_domain": true },
    { "pattern": "befluid.xyz", "custom_domain": true }
  ],
  "env": {
    "staging": {
      "main": "worker.js",
      "assets": { "directory": ".public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "drop-trailing-slash" },
      "vars": { "STAGE": "staging" },
      "routes": [
        { "pattern": "staging.fluid.krackeddevs.com", "custom_domain": true }
      ]
    },
    // a second non-production worker for long-lived branches (worktrees), so staging stays
    // free for master candidates: `npx wrangler deploy --env preview` from the branch checkout
    "preview": {
      "main": "worker.js",
      "assets": { "directory": ".public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "drop-trailing-slash" },
      "vars": { "STAGE": "preview" },
      "routes": [
        { "pattern": "preview.fluid.krackeddevs.com", "custom_domain": true }
      ]
    }
  }
}
